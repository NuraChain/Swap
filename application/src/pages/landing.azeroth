import { Link, useHead, useLoader } from 'azerothjs';

import type { Stats } from '../api.ts';
import { currentLang, fmtNumber, fmtUsd, t } from '../lib/i18n.ts';
import { describe, landingTitle, pageHead, siteOrigin } from '../lib/seo.ts';

import Shamseh from '../components/ui/shamseh.component.azeroth';

export default component Landing()
{
    // The market stats arrive through the route's loader, which runs on both
    // sides: the ISR render bakes them into the cached page (a crawler reads
    // the numbers now, not a numberless shell), and a client-side navigation
    // refetches through the same function. A down api half degrades to no
    // stats section - the loader catches, it never rejects.
    const loader = useLoader<{ stats: Stats | null }>();
    derived stats: Stats | null = loader.data()?.stats ?? null;

    // The head, declared where the page is: the prerender and every ISR
    // regeneration serialize it into the document, and the getters keep a
    // client-side language switch honest without a reload.
    useHead(pageHead({
        title: () => landingTitle(t()),
        description: () => describe(t().landing.sub),
        canonicalPath: '/',
        lang: currentLang,
        jsonLd: () => ({
            '@context': 'https://schema.org',
            '@type': 'WebSite',
            name: 'Nura Swap',
            url: `${ siteOrigin() }/`,
            description: describe(t().landing.sub),
            inLanguage: currentLang()
        })
    }));

    <div>
        <section class="relative overflow-hidden">
            <div class="pointer-events-none absolute -top-40 -end-40 h-[560px] w-[560px] rounded-full bg-glow blur-3xl" />
            <Shamseh
                size={ 640 }
                strokeWidth={ 0.55 }
                class="animate-shamseh pointer-events-none absolute -top-32 -end-48 text-ice opacity-35 [mask-image:radial-gradient(closest-side,black_35%,transparent_78%)]"
            />
            <div class="relative mx-auto max-w-6xl px-4 pb-20 pt-20 sm:pt-28">
                <p class="eyebrow">{ t().landing.liveTitle }</p>
                <h1 class="font-display mt-4 max-w-3xl text-3xl font-bold leading-snug sm:text-5xl sm:leading-tight">
                    { t().landing.headline }
                </h1>
                <p class="mt-6 max-w-xl text-base leading-relaxed text-faint">
                    { t().landing.sub }
                </p>
                <div class="mt-10 flex flex-wrap gap-3">
                    <Link to="/swap" class="btn-ice px-6 py-3 text-sm">
                        { t().landing.cta }
                    </Link>
                    <Link to="/liquidity" class="btn-ghost px-6 py-3 text-sm">
                        { t().landing.ctaPools }
                    </Link>
                </div>
            </div>
        </section>

        <Show when={ stats } let={ live }>
            <section class="border-y border-line bg-panel/70" aria-label={ t().landing.liveTitle }>
                <div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-line px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                    <div class="py-6 sm:pe-8">
                        <div class="eyebrow">{ t().landing.statTvl }</div>
                        <div class="mt-2 font-mono text-3xl tracking-tight text-val" data-ltr>{ fmtUsd(live.tvlUsd) }</div>
                    </div>
                    <div class="py-6 sm:px-8">
                        <div class="eyebrow">{ t().landing.statVolume }</div>
                        <div class="mt-2 font-mono text-3xl tracking-tight text-val" data-ltr>{ fmtUsd(live.volume24hUsd) }</div>
                    </div>
                    <div class="py-6 sm:ps-8">
                        <div class="eyebrow">{ t().landing.statPools }</div>
                        <div class="mt-2 font-mono text-3xl tracking-tight text-val" data-ltr>{ fmtNumber(live.poolCount, 0) }</div>
                    </div>
                </div>
            </section>
        </Show>

        <section class="mx-auto max-w-6xl px-4 py-20">
            <div class="grid gap-6 md:grid-cols-3">
                <article class="card p-6">
                    <Shamseh size={ 22 } class="text-ice" />
                    <h2 class="font-display mt-5 text-base font-medium">{ t().landing.featureSwapTitle }</h2>
                    <p class="mt-3 text-sm leading-relaxed text-faint">{ t().landing.featureSwapBody }</p>
                </article>
                <article class="card p-6">
                    <Shamseh size={ 22 } class="text-ice" />
                    <h2 class="font-display mt-5 text-base font-medium">{ t().landing.featureEarnTitle }</h2>
                    <p class="mt-3 text-sm leading-relaxed text-faint">{ t().landing.featureEarnBody }</p>
                </article>
                <article class="card p-6">
                    <Shamseh size={ 22 } class="text-ice" />
                    <h2 class="font-display mt-5 text-base font-medium">{ t().landing.featureCustodyTitle }</h2>
                    <p class="mt-3 text-sm leading-relaxed text-faint">{ t().landing.featureCustodyBody }</p>
                </article>
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-4 pb-24">
            <h2 class="font-display text-xl font-medium">{ t().landing.howTitle }</h2>
            <ol class="mt-8 grid gap-6 md:grid-cols-3">
                <li class="card p-6">
                    <span class="font-mono text-xs text-ice" data-ltr>01</span>
                    <h3 class="mt-3 text-base font-medium">{ t().landing.how1Title }</h3>
                    <p class="mt-2 text-sm leading-relaxed text-faint">{ t().landing.how1Body }</p>
                </li>
                <li class="card p-6">
                    <span class="font-mono text-xs text-ice" data-ltr>02</span>
                    <h3 class="mt-3 text-base font-medium">{ t().landing.how2Title }</h3>
                    <p class="mt-2 text-sm leading-relaxed text-faint">{ t().landing.how2Body }</p>
                </li>
                <li class="card p-6">
                    <span class="font-mono text-xs text-ice" data-ltr>03</span>
                    <h3 class="mt-3 text-base font-medium">{ t().landing.how3Title }</h3>
                    <p class="mt-2 text-sm leading-relaxed text-faint">{ t().landing.how3Body }</p>
                </li>
            </ol>
        </section>
    </div>
}
