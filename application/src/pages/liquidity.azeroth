import { client } from '../api.ts';
import type { Pool, TokenRef } from '../api.ts';
import { ensureDeployment } from '../lib/chain.ts';
import type { Address } from '../lib/chain.ts';
import { fmtPercentBps } from '../lib/format.ts';
import { fmtUsd, t } from '../lib/i18n.ts';
import { account, txEpoch, watchTokens } from '../lib/wallet/store.ts';

import AddLiquidity from '../components/market/add-liquidity.component.azeroth';
import PositionsGrid from '../components/market/positions-grid.component.azeroth';
import RemoveLiquidity from '../components/market/remove-liquidity.component.azeroth';
import TokenIcon from '../components/market/token-icon.component.azeroth';
import WalletModal from '../components/market/wallet-modal.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Icon from '../components/ui/icon.component.azeroth';
import Input from '../components/ui/input.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';

const NATIVE: TokenRef = { address: 'nura', symbol: 'NURA', name: 'NURA', decimals: 18 };
const PAGE_SIZE = 10;

export default component Liquidity()
{
    state pools: Pool[] = [];
    state tokenList: TokenRef[] = [NATIVE];
    state query = '';
    state page = 1;
    state adding: { a?: TokenRef; b?: TokenRef } | null = null;
    state removing: Pool | null = null;
    state walletOpen = false;

    mount
    {
        void (async () =>
        {
            await ensureDeployment();
            const served = await client.market.tokens();
            tokenList = [NATIVE, ...served];
            watchTokens(served.map((token) => token.address as Address));
        })();
    }

    effect (txEpoch())
    {
        void client.market.pools().then((list) => { pools = list; }).catch(() => undefined);
    }

    derived filtered = pools.filter((pool) =>
    {
        const needle = query.trim().toLowerCase();
        return needle === ''
            || pool.token0.symbol.toLowerCase().includes(needle)
            || pool.token1.symbol.toLowerCase().includes(needle)
            || pool.address.toLowerCase() === needle;
    });

    derived pages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    derived visible = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

    effect (query)
    {
        page = 1;
    }

    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="font-display text-xl font-medium">{ t().liquidity.title }</h1>
            <Button testId="open-add" onClick={ () => { adding = {}; } }>
                <Icon name="plus" size={ 16 } />
                <span>{ t().liquidity.add }</span>
            </Button>
        </div>

        <div class="mt-8">
            <h2 class="eyebrow">{ t().liquidity.myPositions }</h2>
            <Show
                when={ account() !== null }
                fallback={
                    <div class="card mt-3">
                        <EmptyState title={ t().liquidity.connectFirst }>
                            <Button size="sm" onClick={ () => { walletOpen = true; } }>{ t().common.connect }</Button>
                        </EmptyState>
                    </div>
                }
            >
                <PositionsGrid
                    pools={ pools }
                    onAdd={ (pool) => { adding = { a: pool.token0, b: pool.token1 }; } }
                    onRemove={ (pool) => { removing = pool; } }
                />
            </Show>
        </div>

        <div class="mt-10">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="eyebrow">{ t().liquidity.pools }</h2>
                <div class="w-full sm:w-64">
                    <Input bind:value={ query } icon="search" placeholder={ t().liquidity.searchPools } testId="pool-search" />
                </div>
            </div>
            <Show
                when={ visible.length > 0 }
                fallback={
                    <div class="card mt-3">
                        <EmptyState title={ t().liquidity.noPools } />
                    </div>
                }
            >
                <div class="card mt-3 overflow-x-auto">
                    <table class="w-full min-w-[540px] text-sm">
                        <thead>
                            <tr class="border-b border-line text-xs text-faint">
                                <th class="px-4 py-3 text-start font-normal">{ t().liquidity.pools }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().liquidity.tvl }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().liquidity.volume }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().liquidity.apr }</th>
                                <th class="px-4 py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <For each={ visible } key={ (pool) => pool.address } let={ pool }>
                                <tr class="border-b border-line last:border-b-0 hover:bg-ink/4">
                                    <td class="px-4 py-3">
                                        <span class="flex items-center gap-2">
                                            <span class="flex -space-x-2" data-ltr>
                                                <TokenIcon symbol={ pool.token0.symbol } address={ pool.token0.address } size={ 24 } />
                                                <TokenIcon symbol={ pool.token1.symbol } address={ pool.token1.address } size={ 24 } />
                                            </span>
                                            <span class="font-medium" data-ltr>{ `${ pool.token0.symbol }/${ pool.token1.symbol }` }</span>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end font-mono text-val"><span>{ pool.tvlUsd === 0 ? t().liquidity.unpriced : fmtUsd(pool.tvlUsd) }</span></td>
                                    <td class="px-4 py-3 text-end font-mono"><span>{ pool.tvlUsd === 0 ? t().liquidity.unpriced : fmtUsd(pool.volume24hUsd) }</span></td>
                                    <td class="px-4 py-3 text-end">
                                        <Badge tone="rise">{ fmtPercentBps(pool.feeAprBps) }</Badge>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <Button
                                            variant="ghost"
                                            size="sm"
                                            onClick={ () => { adding = { a: pool.token0, b: pool.token1 }; } }
                                        >
                                            { t().liquidity.add }
                                        </Button>
                                    </td>
                                </tr>
                            </For>
                        </tbody>
                    </table>
                </div>
                <div class="mt-4">
                    <Pagination
                        page={ page }
                        pages={ pages }
                        total={ filtered.length }
                        pageSize={ PAGE_SIZE }
                        onPage={ (next) => { page = next; } }
                    />
                </div>
            </Show>
        </div>

        <Show when={ adding !== null }>
            <AddLiquidity
                tokens={ tokenList }
                initialA={ (adding as { a?: TokenRef }).a }
                initialB={ (adding as { b?: TokenRef }).b }
                onClose={ () => { adding = null; } }
            />
        </Show>
        <Show when={ removing } let={ pool }>
            <RemoveLiquidity pool={ pool } onClose={ () => { removing = null; } } />
        </Show>
        <Show when={ walletOpen }>
            <WalletModal onClose={ () => { walletOpen = false; } } />
        </Show>
    </section>
}
