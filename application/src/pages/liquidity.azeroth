import { formatTokenAmount } from '@nuraswap/shared/digits';
import { priceWadFromSqrtX96 } from '@nuraswap/shared/v3-math';

import { client } from '../api.ts';
import type { TokenRef, TokenWithPrice } from '../api.ts';
import { NATIVE_TOKEN, ensureDeployment, v3Addresses } from '../lib/chain.ts';
import type { Address } from '../lib/chain.ts';
import { fmtPercentBps, shortAddress } from '../lib/format.ts';
import { fmtUsd, t } from '../lib/i18n.ts';
import { discoverPools, poolBalances } from '../lib/v3.ts';
import type { PositionView, V3PoolState } from '../lib/v3.ts';
import { account, txEpoch, watchTokens } from '../lib/wallet/store.ts';

import AddV3Liquidity from '../components/market/add-v3-liquidity.component.azeroth';
import ManageV3Position from '../components/market/manage-v3-position.component.azeroth';
import TokenIcon from '../components/market/token-icon.component.azeroth';
import V3PositionsGrid from '../components/market/v3-positions-grid.component.azeroth';
import WalletModal from '../components/market/wallet-modal.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Icon from '../components/ui/icon.component.azeroth';
import Input from '../components/ui/input.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';

const PAGE_SIZE = 10;
// The pool table is a sweep over every pair and tier plus a balance read each.
// txEpoch ticks every five seconds while a wallet is connected, and running that
// sweep at that cadence would hammer a public RPC for a table nobody is watching
// change second to second.
const POOL_REFRESH_MS = 30_000;

// A pool row. TVL is what the pool contract HOLDS, not a reserve-derived
// figure: a concentrated pool has no reserves, and its balances are the only
// honest answer available without an indexer. Volume and fee APR need AGGREGATED
// events, which this client-side sweep does not read - so those columns live on
// the server-backed views rather than printing a zero that reads as "no trades".
interface PoolRow
{
    pool: V3PoolState;
    ref0: TokenRef;
    ref1: TokenRef;
    priceWad: bigint;
    tvlUsd: number;
}

export default component Liquidity()
{
    state tokenList: TokenRef[] = [NATIVE_TOKEN];
    state priced: TokenWithPrice[] = [];
    state rows: PoolRow[] = [];
    state loading = false;
    state query = '';
    state page = 1;
    state adding: { a?: TokenRef; b?: TokenRef; fee?: number } | null = null;
    state managing: PositionView | null = null;
    state walletOpen = false;
    let loadedAt = 0;
    let shape = '';

    mount
    {
        // The rejection is swallowed for the same reason App swallows its own
        // warm-up: an api half that is down is a state this page already renders
        // (an empty registry), and letting it through would add an unhandled
        // rejection to the console of every visitor during an outage.
        void (async () =>
        {
            await ensureDeployment();
            const served = await client.market.tokens();
            batch
            {
                priced = served;
                tokenList = [NATIVE_TOKEN, ...served];
            }
            watchTokens(served.map((token) => token.address as Address));
        })().catch(() => undefined);
    }

    const tokenOf = (address: Address): TokenRef =>
        priced.find((token) => token.address.toLowerCase() === address.toLowerCase())
            ?? { address, symbol: shortAddress(address), name: address, decimals: 18 };

    // Value locked counts ANCHORED prices only - the same rule the server sums by.
    // A pool priced by the deposit that created it cannot vouch for its own size:
    // count the derived side and every two-token pool is worth twice its real half.
    const anchoredUsdOf = (address: Address): number =>
    {
        const token = priced.find((entry) => entry.address.toLowerCase() === address.toLowerCase());
        return token?.anchored === true ? token.priceUsd : 0;
    };

    // The pool table is assembled in the browser: one multicall finds the pools
    // across every pair and tier, a second reads what they hold. It runs no more
    // than once per POOL_REFRESH_MS unless the token list moved, which is the one
    // change that makes the table plainly wrong.
    effect (priced, txEpoch())
    {
        const v3 = v3Addresses();
        if (v3 === null || priced.length === 0)
        {
            return;
        }
        const nextShape = String(priced.length);
        const now = Date.now();
        if (nextShape === shape && now - loadedAt < POOL_REFRESH_MS)
        {
            return;
        }
        shape = nextShape;
        loadedAt = now;
        loading = rows.length === 0;
        void (async () =>
        {
            try
            {
                const found = await discoverPools(v3.factory, priced.map((token) => token.address as Address));
                const held = await poolBalances(found);
                rows = found.map((pool) =>
                {
                    const ref0 = tokenOf(pool.token0);
                    const ref1 = tokenOf(pool.token1);
                    const balance = held.get(pool.address.toLowerCase()) ?? { amount0: 0n, amount1: 0n };
                    // Display arithmetic, so floats are the right tool here - the
                    // USD prices arrive as numbers and the result is a label.
                    const tvlUsd = Number(formatTokenAmount(balance.amount0, ref0.decimals)) * anchoredUsdOf(pool.token0)
                        + Number(formatTokenAmount(balance.amount1, ref1.decimals)) * anchoredUsdOf(pool.token1);
                    return {
                        pool,
                        ref0,
                        ref1,
                        priceWad: priceWadFromSqrtX96(pool.sqrtPriceX96, ref0.decimals, ref1.decimals),
                        tvlUsd: Number.isFinite(tvlUsd) ? tvlUsd : 0
                    };
                });
            }
            catch
            {
                // The next tx epoch retries; the table keeps whatever it had.
            }
            loading = false;
        })();
    }

    derived filtered = rows.filter((row) =>
    {
        const needle = query.trim().toLowerCase();
        return needle === ''
            || row.ref0.symbol.toLowerCase().includes(needle)
            || row.ref1.symbol.toLowerCase().includes(needle)
            || row.pool.address.toLowerCase() === needle;
    });

    derived pages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    derived visible = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

    effect (query)
    {
        page = 1;
    }

    // Closing a sheet may mean a position was just minted or a pool created.
    // The sweep is throttled, so say explicitly that the table is now stale
    // rather than leaving a brand new pool invisible for half a minute.
    const closeSheet = (): void =>
    {
        loadedAt = 0;
        batch
        {
            adding = null;
            managing = null;
        }
    };

    <section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="font-display text-xl font-medium">{ t().liquidity.title }</h1>
            <Button testId="open-add" onClick={ () => { adding = {}; } }>
                <Icon name="plus" size={ 16 } />
                <span>{ t().liquidity.add }</span>
            </Button>
        </div>

        <div class="mt-8">
            <h2 class="eyebrow">{ t().v3.positions }</h2>
            <Show
                when={ account() !== null }
                fallback={
                    <div class="card mt-3">
                        <EmptyState title={ t().liquidity.connectFirst }>
                            <Button size="sm" onClick={ () => { walletOpen = true; } }>{ t().common.connect }</Button>
                        </EmptyState>
                    </div>
                }
            >
                <V3PositionsGrid tokens={ tokenList } onManage={ (view) => { managing = view; } } />
            </Show>
        </div>

        <div class="mt-10">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="eyebrow">{ t().liquidity.pools }</h2>
                <div class="w-full sm:w-64">
                    <Input bind:value={ query } icon="search" placeholder={ t().liquidity.searchPools } testId="pool-search" />
                </div>
            </div>

            <Show
                when={ visible.length > 0 }
                fallback={
                    <div class="card mt-3">
                        <EmptyState title={ loading ? t().common.loading : t().v3.noPools } />
                    </div>
                }
            >
                <div class="card mt-3 overflow-x-auto">
                    <table class="w-full min-w-[540px] text-sm">
                        <thead>
                            <tr class="border-b border-line text-xs text-faint">
                                <th class="px-4 py-3 text-start font-normal">{ t().liquidity.pools }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().v3.feeTier }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().liquidity.price }</th>
                                <th class="px-4 py-3 text-end font-normal">{ t().liquidity.tvl }</th>
                                <th class="px-4 py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <For each={ visible } key={ (row) => row.pool.address } let={ row }>
                                <tr class="border-b border-line last:border-b-0 hover:bg-ink/4">
                                    <td class="px-4 py-3">
                                        <span class="flex items-center gap-2">
                                            <span class="flex -space-x-2" data-ltr>
                                                <TokenIcon symbol={ row.ref0.symbol } address={ row.ref0.address } size={ 24 } />
                                                <TokenIcon symbol={ row.ref1.symbol } address={ row.ref1.address } size={ 24 } />
                                            </span>
                                            <span class="font-medium" data-ltr>{ `${ row.ref0.symbol }/${ row.ref1.symbol }` }</span>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <Badge tone="ice" ltr>{ fmtPercentBps(row.pool.fee / 100) }</Badge>
                                    </td>
                                    <td class="px-4 py-3 text-end font-mono" data-ltr>
                                        <span>{ formatTokenAmount(row.priceWad, 18, 6) }</span>
                                    </td>
                                    <td class="px-4 py-3 text-end text-val">
                                        <span class={ row.tvlUsd === 0 ? '' : 'font-mono' }>
                                            { row.tvlUsd === 0 ? t().liquidity.unpriced : fmtUsd(row.tvlUsd) }
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <Button
                                            variant="ghost"
                                            size="sm"
                                            onClick={ () => { adding = { a: row.ref0, b: row.ref1, fee: row.pool.fee }; } }
                                        >
                                            { t().liquidity.add }
                                        </Button>
                                    </td>
                                </tr>
                            </For>
                        </tbody>
                    </table>
                </div>
            </Show>

            <Show when={ filtered.length > 0 }>
                <div class="mt-4">
                    <Pagination
                        page={ page }
                        pages={ pages }
                        total={ filtered.length }
                        pageSize={ PAGE_SIZE }
                        onPage={ (next) => { page = next; } }
                    />
                </div>
            </Show>
        </div>

        <Show when={ adding !== null }>
            <AddV3Liquidity
                tokens={ tokenList }
                initialA={ (adding as { a?: TokenRef }).a }
                initialB={ (adding as { b?: TokenRef }).b }
                initialFee={ (adding as { fee?: number }).fee }
                onClose={ closeSheet }
            />
        </Show>
        <Show when={ managing } let={ view }>
            <ManageV3Position view={ view } onClose={ closeSheet } />
        </Show>
        <Show when={ walletOpen }>
            <WalletModal onClose={ () => { walletOpen = false; } } />
        </Show>
    </section>
}
