import { onCleanup, useQuery } from 'azerothjs';

import { minOutForSlippage, priceImpactBps } from '@nuraswap/shared/math';
import { priceImpactBpsFromMid, rawPriceWadFromSqrtX96 } from '@nuraswap/shared/v3-math';
import { formatTokenAmount, parseTokenAmount } from '@nuraswap/shared/digits';

import { client } from '../api.ts';
import type { DeploymentInfo, TokenRef } from '../api.ts';
import { ERC20_ABI, FACTORY_ABI, PAIR_ABI, ROUTER_ABI, WNURA_ABI, deployment, ensureDeployment, publicClient, v3Addresses } from '../lib/chain.ts';
import type { Address } from '../lib/chain.ts';
import { fmtPercentBps } from '../lib/format.ts';
import { t } from '../lib/i18n.ts';
import { bestTier, buildV3Swap, poolsForPair, quoteAllTiers } from '../lib/v3.ts';
import type { Protocol, TierQuote, V3PoolState } from '../lib/v3.ts';
import {
    account,
    balances,
    nativeBalance,
    onRightChain,
    requiredWallet,
    sendTx,
    switchChain,
    txEpoch,
    watchTokens
} from '../lib/wallet/store.ts';

import AmountField from '../components/market/amount-field.component.azeroth';
import FeeTierSelect from '../components/market/fee-tier-select.component.azeroth';
import PriceChart from '../components/market/price-chart.component.azeroth';
import ProtocolSwitch from '../components/market/protocol-switch.component.azeroth';
import TokenSelect from '../components/market/token-select.component.azeroth';
import TxList from '../components/market/tx-list.component.azeroth';
import WalletModal from '../components/market/wallet-modal.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Icon from '../components/ui/icon.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// The native pseudo-token: swaps route through the router's ETH entrypoints and
// WNURA<->NURA is a direct wrap. Everything else treats it as WNURA.
const NATIVE: TokenRef = { address: 'nura', symbol: 'NURA', name: 'NURA', decimals: 18 };
const MAX_UINT256 = (1n << 256n) - 1n;
const HIGH_IMPACT_BPS = 1500;

// The route and the price age on their own: the pool moves under trades nobody
// on this page made. Half a minute is short enough that a displayed price is
// still the one the router would honour, and long enough not to hammer a public
// RPC with a full re-quote (pair lookups, getAmountsOut, per-hop reserves).
const QUOTE_REFRESH_MS = 30_000;

interface QuoteState
{
    out: bigint;
    impactBps: number;
    /** The V2 hop list. Empty on a V3 quote, which is single-hop by tier. */
    path: Address[];
    /** The V3 fee tier this quote came from, in ppm; null on a V2 quote. */
    fee: number | null;
}

export default component Swap()
{
    state info: DeploymentInfo | null = null;
    state tokenIn: TokenRef = NATIVE;
    state tokenOut: TokenRef | null = null;
    state amountText = '';
    state quote: QuoteState | null = null;
    state noRoute = false;
    state quoting = false;
    state allowance = 0n;
    state busy = false;
    state pickerFor: 'in' | 'out' | null = null;
    state walletOpen = false;
    state settingsOpen = false;
    state confirmedHighImpact = false;
    state quoteTick = 0;
    // The pool's fee, in basis points, straight from the factory. Null until it
    // answers, and nothing quotes before then: an impact figure computed against
    // a guessed fee reports the guess, not the trade.
    state feeBps: number | null = null;
    // Which exchange this card is trading. V2 unless the trader says otherwise,
    // and forced back to V2 on a chain whose deployment carries no V3 - the
    // switch is not rendered there, so a stored 'v3' would strand the page.
    state protocol: Protocol = 'v2';
    // The pinned V3 fee tier, or null for "whichever quotes best". Pinning is a
    // per-trade decision, so unlike slippage it is deliberately not persisted.
    state feeTier: number | null = null;
    state tierQuotes: TierQuote[] = [];
    state slippageBps = 50;
    state deadlineMinutes = 20;
    state infiniteApprove = false;

    state tokenList: TokenRef[] = [NATIVE];

    /** The token+account+spender the allowance was read for; a refresh of the same key keeps it. */
    let allowanceKey = '';

    // Read on mount only - see the pair link in mount below.
    const query = useQuery();

    mount
    {
        try
        {
            const stored = JSON.parse(window.localStorage.getItem('nuraswap.swap-settings') ?? '{}') as
                { slippageBps?: number; deadlineMinutes?: number; infiniteApprove?: boolean; protocol?: string };
            if (typeof stored.slippageBps === 'number' && stored.slippageBps > 0 && stored.slippageBps <= 5000)
            {
                slippageBps = stored.slippageBps;
            }
            if (typeof stored.deadlineMinutes === 'number' && stored.deadlineMinutes > 0 && stored.deadlineMinutes <= 4320)
            {
                deadlineMinutes = stored.deadlineMinutes;
            }
            if (typeof stored.infiniteApprove === 'boolean')
            {
                infiniteApprove = stored.infiniteApprove;
            }
            if (stored.protocol === 'v3')
            {
                protocol = 'v3';
            }
        }
        catch
        {
            // Defaults stand.
        }
        void (async () =>
        {
            info = await ensureDeployment();
            void publicClient().readContract({
                address: (info as DeploymentInfo).contracts.factory as Address,
                abi: FACTORY_ABI,
                functionName: 'swapFee'
            }).then((bps) => { feeBps = Number(bps); }).catch(() => undefined);
            const served = await client.market.tokens();
            tokenList = [NATIVE, ...served];
            tokenOut = served.find((token) => token.symbol === 'NURA') ?? served[0] ?? null;
            watchTokens(served.map((token) => token.address as Address));

            // A link can name the pair: /swap?in=<address|nura>&out=<address|nura>.
            // The portfolio's wrap/unwrap actions are the first callers - they land
            // here with both sides chosen and the page recognises the wrap itself.
            // Read once, on mount: after that the pickers belong to whoever is using
            // them, not to the address bar.
            const named = (value: unknown): TokenRef | null =>
            {
                if (typeof value !== 'string' || value === '')
                {
                    return null;
                }
                if (value.toLowerCase() === NATIVE.address)
                {
                    return NATIVE;
                }
                return served.find((token) => token.address.toLowerCase() === value.toLowerCase()) ?? null;
            };
            const asked = query();
            const wantedIn = named(asked.in);
            const wantedOut = named(asked.out);
            // Both sides at once, and never the same token twice: a pair that names
            // one token on both sides is not a trade.
            batch
            {
                if (wantedIn !== null && wantedIn.address !== wantedOut?.address)
                {
                    tokenIn = wantedIn;
                }
                if (wantedOut !== null && wantedOut.address !== tokenIn.address)
                {
                    tokenOut = wantedOut;
                }
            }
        // Swallowed for the same reason App swallows its own warm-up: a down api
        // half is a state this card already renders - no token list, no quote -
        // and letting the rejection through would put an unhandled error in the
        // console of every visitor during an outage.
        })().catch(() => undefined);

        // A tab nobody is looking at stops asking - the same gate the wallet
        // store's balance poll uses - and re-quotes the moment it is looked at
        // again, because the first thing a returning trader reads is the price.
        const onVisible = (): void =>
        {
            if (!document.hidden)
            {
                quoteTick++;
            }
        };
        const refresh = setInterval(onVisible, QUOTE_REFRESH_MS);
        document.addEventListener('visibilitychange', onVisible);
        onCleanup(() =>
        {
            clearInterval(refresh);
            document.removeEventListener('visibilitychange', onVisible);
        });
    }

    effect (slippageBps, deadlineMinutes, infiniteApprove, protocol) with { skipInitial: true }
    {
        try
        {
            window.localStorage.setItem(
                'nuraswap.swap-settings',
                JSON.stringify({ slippageBps, deadlineMinutes, infiniteApprove, protocol })
            );
        }
        catch
        {
            // Preference lives for the session only.
        }
    }

    // A chain with no V3 half never renders the switch, so a 'v3' left in storage
    // by a chain that HAD one would point this card at nothing at all.
    effect (info)
    {
        if (info !== null && v3Addresses() === null)
        {
            protocol = 'v2';
        }
    }

    const wnuraAddress = (): Address => (deployment()?.contracts.wnura ?? '0x') as Address;
    const routerAddress = (): Address => (deployment()?.contracts.router ?? '0x') as Address;
    // Allowances and swaps go to DIFFERENT contracts per protocol: V2 pulls
    // through the V2 router, V3 through the SwapRouter. Approving one and then
    // swapping through the other reverts inside a token transfer, which is the
    // least legible way for a trade to fail.
    const spender = (): Address =>
    {
        const v3 = protocol === 'v3' ? v3Addresses() : null;
        return v3 === null ? routerAddress() : v3.swapRouter;
    };
    const isNative = (token: TokenRef): boolean => token.address === 'nura';
    const hopAddress = (token: TokenRef): Address =>
        (isNative(token) ? wnuraAddress() : token.address) as Address;

    derived parsedIn = parseTokenAmount(amountText, tokenIn.decimals);

    // The charted pool: the selected exchange's own pool for the pair when it
    // exists, else the out-token's WNURA pool - there is always a price story
    // next to the trade.
    state chartPair: Address | null = null;
    // Which exchange the chart ended up on when it is NOT the selected one, so
    // the note under it can name the right pool. The two price independently -
    // this pair sits at a different number on each - so borrowing a chart is
    // something to say out loud, never something to do silently.
    state chartNote: Protocol | null = null;
    let chartLookup = 0;

    // Every address is captured BEFORE the first await: a reactive read inside an
    // async continuation happens outside the effect's tracking scope, so the
    // resolved pair never landed after a re-run and the chart stayed blank. The
    // last resolved pair also stays on screen while a new one resolves, so
    // flipping direction never blanks the chart.
    effect (tokenIn, tokenOut, info, protocol, feeTier)
    {
        const out = tokenOut;
        const current = info;
        const selected = protocol;
        const pinnedTier = feeTier;
        if (current === null || out === null)
        {
            chartPair = null;
            chartNote = null;
            return;
        }
        const factory = (current as DeploymentInfo).contracts.factory as Address;
        const v3 = v3Addresses();
        const wnura = wnuraAddress();
        const from = hopAddress(tokenIn);
        const to = hopAddress(out);
        // Only the newest lookup may write: two runs in flight can resolve out of
        // order, and a stale one would overwrite the live pair with its own answer.
        chartLookup++;
        const generation = chartLookup;

        // The V2 pair for this trade: the direct one, else the out-token's WNURA
        // pool, so there is always a price story next to the trade.
        const v2PairOf = async (): Promise<Address | null> =>
        {
            const zero = '0x0000000000000000000000000000000000000000';
            const direct = await publicClient().readContract({
                address: factory, abi: FACTORY_ABI, functionName: 'getPair', args: [from, to]
            }).catch(() => zero) as Address;
            if (direct !== zero)
            {
                return direct;
            }
            const viaWnura = await publicClient().readContract({
                address: factory, abi: FACTORY_ABI, functionName: 'getPair', args: [to, wnura]
            }).catch(() => zero) as Address;
            return viaWnura === zero ? null : viaWnura;
        };

        // The V3 pool for this trade: the pinned tier is the one the trade will
        // actually touch. On Auto nothing is pinned, and the deepest pool is both
        // where a quote almost always routes and where the trades already are.
        const v3PoolOf = async (): Promise<Address | null> =>
        {
            if (v3 === null)
            {
                return null;
            }
            const pools = await poolsForPair(v3.factory, from, to).catch((): V3PoolState[] => []);
            const pinned = pinnedTier === null
                ? null
                : pools.find((pool) => pool.fee === pinnedTier) ?? null;
            const deepest = pools.reduce<V3PoolState | null>(
                (best, pool) => (best === null || pool.liquidity > best.liquidity ? pool : best),
                null
            );
            return (pinned ?? deepest)?.address ?? null;
        };

        // A pool with liquidity but no trades charts NOTHING - the series is drawn
        // from swaps, and a deposit is deliberately not one. That is the whole
        // reason to look at the other exchange before settling for an empty card.
        const hasTrades = async (address: Address): Promise<boolean> =>
            client.market.pool({ params: { address } })
                .then((detail) => detail.candles.some(
                    (candle) => candle.volume0 !== '0' || candle.volume1 !== '0'
                ))
                .catch(() => false);

        void (async () =>
        {
            const own = selected === 'v3' ? await v3PoolOf() : await v2PairOf();
            if (generation !== chartLookup)
            {
                return;
            }
            // The selected exchange's own pool wins whenever it has anything to
            // draw: the chart must match the trade being quoted, not the busier
            // market next door.
            if (own !== null && await hasTrades(own))
            {
                if (generation === chartLookup)
                {
                    chartPair = own;
                    chartNote = null;
                }
                return;
            }
            if (generation !== chartLookup)
            {
                return;
            }
            const other = selected === 'v3' ? await v2PairOf() : await v3PoolOf();
            if (generation !== chartLookup)
            {
                return;
            }
            if (other !== null && await hasTrades(other))
            {
                if (generation === chartLookup)
                {
                    chartPair = other;
                    chartNote = selected === 'v3' ? 'v2' : 'v3';
                }
                return;
            }
            // Neither has traded. Stay on the selected exchange's own pool and let
            // the chart say so, rather than borrowing an equally empty one.
            if (generation === chartLookup)
            {
                chartPair = own ?? other;
                chartNote = null;
            }
        })();
    }

    // Case-insensitively, because the two sides of this comparison come from
    // different places: the token list is served lowercased out of the indexer's
    // db, while contracts.wnura keeps whatever case the deployment artifact was
    // written in. Compared literally, WNURA never equalled WNURA - so picking
    // WNURA and NURA looked like a pair with no pool, and offered to approve the
    // router for a trade that is a withdraw.
    const sameToken = (left: string, right: string): boolean =>
        left.toLowerCase() === right.toLowerCase();

    derived isWrapPair = tokenOut !== null
        && ((isNative(tokenIn) && sameToken(hopAddress(tokenOut as TokenRef), wnuraAddress()) && !isNative(tokenOut as TokenRef))
            || (isNative(tokenOut as TokenRef) && sameToken(hopAddress(tokenIn), wnuraAddress()) && !isNative(tokenIn)));

    derived balanceIn = isNative(tokenIn)
        ? nativeBalance()
        : balances()[tokenIn.address.toLowerCase()] ?? 0n;

    derived balanceOut = tokenOut === null
        ? null
        : isNative(tokenOut as TokenRef)
            ? nativeBalance()
            : balances()[(tokenOut as TokenRef).address.toLowerCase()] ?? 0n;

    // Quote: authoritative amounts from the router, impact from per-hop reserves.
    // Reruns on every input change and on the QUOTE_REFRESH_MS tick - it used to
    // ride the wallet store's txEpoch, which meant a connected wallet re-quoted
    // every 5 seconds and a page with no wallet never re-quoted at all. The route
    // is re-read with the price: a pair that did not exist a minute ago is a
    // route now, and one that drained is not.
    //
    // A tick with the SAME inputs is a refresh, and a refresh keeps what is on
    // screen: the numbers stay, the button stays live, and the new answer
    // replaces the old one when it lands. Blanking a filled-in trade every half
    // minute reads as a glitch.
    let quoteKey = '';

    effect (amountText, tokenIn, tokenOut, quoteTick, feeBps, protocol, feeTier, info)
    {
        const out = tokenOut;
        const amount = parsedIn;
        const key = `${ amountText }|${ tokenIn.address }|${ out?.address ?? '' }|${ protocol }|${ feeTier ?? 'auto' }`;
        const refreshing = key === quoteKey && quote !== null;
        quoteKey = key;
        if (!refreshing)
        {
            quote = null;
            noRoute = false;
            confirmedHighImpact = false;
        }
        // The factory's swapFee gates a V2 quote and only a V2 quote: a V3 trade
        // is priced by its tier, and waiting on a number it never reads would
        // leave the V3 card blank whenever that one read failed.
        if (info === null || out === null || amount === null || amount <= 0n
            || (protocol === 'v2' && feeBps === null))
        {
            return;
        }
        if (isWrapPair)
        {
            quote = { out: amount, impactBps: 0, path: [], fee: null };
            return;
        }
        // A high-impact trade was confirmed at ITS impact. If the refresh comes
        // back worse, that consent does not carry over to the new price.
        const confirmedAt = refreshing ? (quote as QuoteState).impactBps : 0;
        quoting = !refreshing;
        const requestToken = amountText + out.address + tokenIn.address;
        if (protocol === 'v3')
        {
            const v3 = v3Addresses();
            if (v3 === null)
            {
                noRoute = true;
                quoting = false;
                return;
            }
            void (async () =>
            {
                try
                {
                    const from = hopAddress(tokenIn);
                    const to = hopAddress(out);
                    const quotes = await quoteAllTiers(v3.factory, v3.quoter, from, to, amount);
                    if (requestToken !== amountText + (tokenOut as TokenRef).address + tokenIn.address)
                    {
                        quoting = false;
                        return;
                    }
                    tierQuotes = quotes;
                    // A pinned tier that cannot fill THIS size falls back to the
                    // best one rather than reporting no route: the pool is there,
                    // it is this amount it cannot take.
                    const pinned = feeTier === null
                        ? null
                        : quotes.find((tier) => tier.fee === feeTier && tier.out > 0n) ?? null;
                    const chosen = pinned ?? bestTier(quotes);
                    if (chosen === null)
                    {
                        quote = null;
                        noRoute = true;
                        quoting = false;
                        return;
                    }
                    // Impact against the pool's own mid price with the fee taken
                    // out - the same measure the V2 card reports, so a trader
                    // comparing the two protocols is comparing like with like.
                    const zeroForOne = from.toLowerCase() === chosen.pool.token0.toLowerCase();
                    const mid = rawPriceWadFromSqrtX96(chosen.pool.sqrtPriceX96, zeroForOne);
                    const impact = priceImpactBpsFromMid(amount, chosen.out, mid, chosen.fee);
                    quote = { out: chosen.out, impactBps: impact, path: [], fee: chosen.fee };
                    if (impact > confirmedAt)
                    {
                        confirmedHighImpact = false;
                    }
                }
                catch
                {
                    quote = null;
                    noRoute = true;
                }
                quoting = false;
            })();
            return;
        }
        tierQuotes = [];
        void (async () =>
        {
            try
            {
                const reader = publicClient();
                const factory = (info as DeploymentInfo).contracts.factory as Address;
                const from = hopAddress(tokenIn);
                const to = hopAddress(out);
                const direct = await reader.readContract({
                    address: factory,
                    abi: FACTORY_ABI,
                    functionName: 'getPair',
                    args: [from, to]
                }) as Address;
                let path: Address[];
                if (direct !== '0x0000000000000000000000000000000000000000')
                {
                    path = [from, to];
                }
                else
                {
                    const wnura = wnuraAddress();
                    const legIn = await reader.readContract({
                        address: factory, abi: FACTORY_ABI, functionName: 'getPair', args: [from, wnura]
                    }) as Address;
                    const legOut = await reader.readContract({
                        address: factory, abi: FACTORY_ABI, functionName: 'getPair', args: [wnura, to]
                    }) as Address;
                    if (legIn === '0x0000000000000000000000000000000000000000'
                        || legOut === '0x0000000000000000000000000000000000000000')
                    {
                        // The route a refresh was re-reading is gone; so is its price.
                        quote = null;
                        noRoute = true;
                        quoting = false;
                        return;
                    }
                    path = [from, wnura, to];
                }

                const amounts = await reader.readContract({
                    address: routerAddress(),
                    abi: ROUTER_ABI,
                    functionName: 'getAmountsOut',
                    args: [amount, path]
                }) as bigint[];

                // Per-hop impact from live reserves, compounded over the route.
                let impact = 0;
                for (let hop = 0; hop < path.length - 1; hop++)
                {
                    const pair = await reader.readContract({
                        address: factory, abi: FACTORY_ABI, functionName: 'getPair', args: [path[hop], path[hop + 1]]
                    }) as Address;
                    const [reserve0, reserve1] = await reader.readContract({
                        address: pair, abi: PAIR_ABI, functionName: 'getReserves'
                    }) as [bigint, bigint, number];
                    const token0 = await reader.readContract({
                        address: pair, abi: PAIR_ABI, functionName: 'token0'
                    }) as Address;
                    const [reserveIn, reserveOut] = token0.toLowerCase() === path[hop].toLowerCase()
                        ? [reserve0, reserve1]
                        : [reserve1, reserve0];
                    impact += priceImpactBps(amounts[hop], amounts[hop + 1], reserveIn, reserveOut, feeBps as number);
                }

                if (requestToken === amountText + (tokenOut as TokenRef).address + tokenIn.address)
                {
                    quote = { out: amounts[amounts.length - 1], impactBps: impact, path, fee: null };
                    if (impact > confirmedAt)
                    {
                        confirmedHighImpact = false;
                    }
                }
            }
            catch
            {
                // A refresh that fails drops the price it was refreshing: an
                // unreachable RPC is not a reason to keep quoting an old number
                // as if the router had just said it.
                quote = null;
                noRoute = true;
            }
            quoting = false;
        })();
    }

    // Allowance follows the input token, the account, the protocol (each has its
    // own router to approve) and every confirmed tx.
    //
    // "Approved until the read says otherwise" is the right first paint, but only
    // ONCE per token+account+spender: this effect also reruns on the 5s refresh
    // tick, and re-blanking a known allowance there dropped the approve gate for
    // the length of an RPC round-trip, every five seconds. The action button
    // flipped between "Approve X" and "Swap" on its own, and a click that landed
    // in the gap sent a swap the router had no allowance for - which reverts.
    effect (tokenIn, account(), txEpoch(), protocol, info)
    {
        const owner = account();
        const key = `${ owner ?? '' }|${ tokenIn.address }|${ info === null ? '' : spender() }`;
        if (key !== allowanceKey)
        {
            allowanceKey = key;
            allowance = MAX_UINT256;
        }
        if (info === null || owner === null || isNative(tokenIn))
        {
            return;
        }
        void publicClient().readContract({
            address: tokenIn.address as Address,
            abi: ERC20_ABI,
            functionName: 'allowance',
            args: [owner, spender()]
        }).then((value) => { allowance = value as bigint; }).catch(() => undefined);
    }

    // Holes under a <Show> re-evaluate while the guard is reacting, so markup
    // never reads `quote` members directly - only these null-safe projections.
    derived quoteOut = quote?.out ?? 0n;
    derived quoteImpact = quote?.impactBps ?? 0;

    // Wrapping never needs an allowance: deposit() takes native value and
    // withdraw() burns the caller's OWN balance - neither moves tokens through
    // the router, so demanding approval here would cost a pointless transaction.
    derived needsApprove = !isWrapPair
        && !isNative(tokenIn)
        && parsedIn !== null
        && allowance < (parsedIn as bigint);

    derived insufficient = parsedIn !== null && (parsedIn as bigint) > balanceIn;

    derived highImpact = quote !== null && (quote as QuoteState).impactBps >= HIGH_IMPACT_BPS;

    // Chain time, not wall time: the local chain's clock is offset by the seed
    // tape and a user's clock can skew. And on an automining chain the LATEST
    // block lags the node's clock by the whole idle gap - the pending block is
    // the referee the router will actually consult.
    const deadline = async (): Promise<bigint> =>
    {
        const reader = publicClient();
        const block = await reader.getBlock({ blockTag: 'pending' }).catch(() => reader.getBlock());
        return block.timestamp + BigInt(deadlineMinutes * 60);
    };

    // Switching protocol drops the pinned tier and the tiers themselves: they
    // describe V3 pools, and carrying them across would offer a V2 trader a
    // choice that does not exist on their side of the exchange.
    const chooseProtocol = (next: Protocol): void =>
    {
        if (next === protocol)
        {
            return;
        }
        batch
        {
            protocol = next;
            feeTier = null;
            tierQuotes = [];
        }
    };

    // The fee on screen: the factory's for V2, the quoted tier's for V3. Tiers
    // are parts per million and this reads basis points, hence the /100.
    derived shownFeeBps = protocol === 'v3' ? (quote?.fee ?? 0) / 100 : feeBps ?? 0;

    // Batched: written one at a time, the halfway state has the SAME token on both
    // sides, and the quote and chart effects run against a pair that cannot exist.
    const flip = (): void =>
    {
        if (tokenOut === null)
        {
            return;
        }
        const nextIn = tokenOut as TokenRef;
        batch
        {
            tokenOut = tokenIn;
            tokenIn = nextIn;
            amountText = '';
        }
    };

    const approve = async (): Promise<void> =>
    {
        const amount = parsedIn;
        if (amount === null)
        {
            return;
        }
        busy = true;
        await sendTx(
            `${ t().swap.approve } ${ tokenIn.symbol }`,
            () => requiredWallet().writeContract({
                address: tokenIn.address as Address,
                abi: ERC20_ABI,
                functionName: 'approve',
                args: [spender(), infiniteApprove ? MAX_UINT256 : amount]
            } as never)
        );
        busy = false;
    };

    const swap = async (): Promise<void> =>
    {
        const out = tokenOut;
        const amount = parsedIn;
        const current = quote;
        if (out === null || amount === null)
        {
            return;
        }
        busy = true;
        const owner = account() as Address;
        if (isWrapPair)
        {
            await sendTx(
                isNative(tokenIn) ? t().swap.wrap : t().swap.unwrap,
                () => (isNative(tokenIn)
                    ? requiredWallet().writeContract({
                        address: wnuraAddress(), abi: WNURA_ABI, functionName: 'deposit', value: amount
                    } as never)
                    : requiredWallet().writeContract({
                        address: wnuraAddress(), abi: WNURA_ABI, functionName: 'withdraw', args: [amount]
                    } as never))
            );
        }
        else if (current !== null)
        {
            const minOut = minOutForSlippage(current.out, slippageBps);
            const when = await deadline();
            // FSI/PDI isolate the Latin pair so the toast renders deterministically in RTL.
            const label = `${ t().swap.swapAction } ⁨${ tokenIn.symbol } → ${ out.symbol }⁩`;
            if (protocol === 'v3')
            {
                const v3 = v3Addresses();
                // The tier signed is the QUOTE's tier, never the picker's: under
                // Auto the picker says nothing at all, and under a pin that could
                // not fill they differ - either way, swapping through a pool that
                // did not produce the number on screen is not the trade shown.
                if (v3 === null || current.fee === null)
                {
                    busy = false;
                    return;
                }
                const request = await buildV3Swap({
                    router: v3.swapRouter,
                    tokenIn: hopAddress(tokenIn),
                    tokenOut: hopAddress(out),
                    fee: current.fee,
                    amountIn: amount,
                    amountOutMin: minOut,
                    recipient: owner,
                    deadline: when,
                    nativeIn: isNative(tokenIn),
                    nativeOut: isNative(out)
                });
                await sendTx(label, () => requiredWallet().writeContract(request as never));
            }
            else if (isNative(tokenIn))
            {
                await sendTx(label, () => requiredWallet().writeContract({
                    address: routerAddress(),
                    abi: ROUTER_ABI,
                    functionName: 'swapExactETHForTokens',
                    args: [minOut, current.path, owner, when],
                    value: amount
                } as never));
            }
            else if (isNative(out))
            {
                await sendTx(label, () => requiredWallet().writeContract({
                    address: routerAddress(),
                    abi: ROUTER_ABI,
                    functionName: 'swapExactTokensForETH',
                    args: [amount, minOut, current.path, owner, when]
                } as never));
            }
            else
            {
                await sendTx(label, () => requiredWallet().writeContract({
                    address: routerAddress(),
                    abi: ROUTER_ABI,
                    functionName: 'swapExactTokensForTokens',
                    args: [amount, minOut, current.path, owner, when]
                } as never));
            }
            amountText = '';
        }
        busy = false;
    };

    <section class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:py-12 lg:grid-cols-[1fr_minmax(24rem,26rem)]">
        <div class="order-2 flex min-w-0 flex-col gap-6 lg:order-1">
            <Show when={ chartPair } let={ pair }>
                <div class="flex flex-col gap-2">
                    <PriceChart pairAddress={ pair } />
                    <Show when={ chartNote } let={ from }>
                        <p class="text-xs leading-relaxed text-faint">
                            { from === 'v2' ? t().v3.chartFromV2 : t().v3.chartFromV3 }
                        </p>
                    </Show>
                </div>
            </Show>
            <TxList limit={ 8 } filterable />
        </div>
        <div class="order-1 w-full max-w-md justify-self-center lg:order-2 lg:justify-self-auto">
            <div class="card-pop p-4 sm:p-5">
                <div class="mb-4 flex items-center justify-between gap-2">
                    <h1 class="font-display text-base font-medium">{ t().swap.title }</h1>
                    <div class="flex items-center gap-1.5">
                        <Show when={ v3Addresses() !== null }>
                            <ProtocolSwitch value={ protocol } onChange={ chooseProtocol } />
                        </Show>
                        <button
                            type="button"
                            class="rounded-lg p-2 text-faint hover:text-ink"
                            aria-label={ t().common.settings }
                            aria-expanded={ String(settingsOpen) }
                            onClick={ () => { settingsOpen = !settingsOpen; } }
                        >
                            <Icon name="settings-2" size={ 18 } />
                        </button>
                    </div>
                </div>

                <Show when={ settingsOpen }>
                    <div class="mb-4 flex flex-col gap-4 rounded-xl border border-line bg-raised p-4">
                        <div>
                            <div class="flex items-center gap-1.5 text-xs text-faint">
                                <span>{ t().swap.slippage }</span>
                                <Tooltip label={ t().swap.slippageHint }>
                                    <Icon name="triangle-alert" size={ 12 } class="text-faint" />
                                </Tooltip>
                            </div>
                            <div class="mt-2 flex gap-2">
                                <button
                                    type="button"
                                    class={ slippageBps === 50 ? 'btn-ice h-8 px-3 text-xs' : 'btn-ghost h-8 px-3 text-xs' }
                                    onClick={ () => { slippageBps = 50; } }
                                >
                                { t().swap.auto }
                                </button>
                                <button
                                    type="button"
                                    class={ slippageBps === 10 ? 'btn-ice h-8 px-3 text-xs' : 'btn-ghost h-8 px-3 text-xs' }
                                    onClick={ () => { slippageBps = 10; } }
                                >
                                0.1%
                                </button>
                                <button
                                    type="button"
                                    class={ slippageBps === 100 ? 'btn-ice h-8 px-3 text-xs' : 'btn-ghost h-8 px-3 text-xs' }
                                    onClick={ () => { slippageBps = 100; } }
                                >
                                1%
                                </button>
                                <button
                                    type="button"
                                    class={ slippageBps === 300 ? 'btn-ice h-8 px-3 text-xs' : 'btn-ghost h-8 px-3 text-xs' }
                                    onClick={ () => { slippageBps = 300; } }
                                >
                                3%
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-1.5 text-xs text-faint">
                                <span>{ t().swap.deadline }</span>
                                <Tooltip label={ t().swap.deadlineHint }>
                                    <Icon name="triangle-alert" size={ 12 } class="text-faint" />
                                </Tooltip>
                            </div>
                            <label class="flex items-center gap-2 text-xs">
                                <input
                                    class="w-14 rounded-md border border-line bg-panel px-2 py-1 text-end font-mono outline-none focus:border-ice"
                                    value={ String(deadlineMinutes) }
                                    inputmode="numeric"
                                    data-ltr
                                    onInput={ (event) =>
                                {
                                    const parsed = Number.parseInt((event.currentTarget as HTMLInputElement).value, 10);
                                    if (Number.isFinite(parsed) && parsed > 0 && parsed <= 4320)
                                    {
                                        deadlineMinutes = parsed;
                                    }
                                } }
                            />
                                <span class="text-faint">{ t().swap.minutes }</span>
                            </label>
                        </div>
                        <label class="flex items-start gap-2.5 text-xs">
                            <input
                                type="checkbox"
                                class="mt-0.5 accent-(--ice)"
                                checked={ infiniteApprove }
                                onChange={ (event) => { infiniteApprove = (event.currentTarget as HTMLInputElement).checked; } }
                        />
                            <span>
                                <span class="block font-medium text-ink">{ t().swap.infiniteApprove }</span>
                                <span class="mt-0.5 block leading-relaxed text-faint">{ t().swap.infiniteApproveHint }</span>
                            </span>
                        </label>
                    </div>
                </Show>

                <div class="flex flex-col gap-2">
                    <AmountField
                        label={ t().swap.from }
                        amount={ amountText }
                        onAmount={ (value) => { amountText = value; } }
                        token={ tokenIn }
                        onPickToken={ () => { pickerFor = 'in'; } }
                        balance={ balanceIn }
                        onMax={ () => { amountText = formatTokenAmount(balanceIn, tokenIn.decimals); } }
                        testId="amount-in"
                />
                    <div class="relative z-10 -my-4 flex justify-center">
                        <button
                            type="button"
                            class="card-pop flex h-9 w-9 items-center justify-center rounded-full text-faint hover:text-ice"
                            aria-label={ t().swap.switchDirection }
                            data-testid="flip"
                            onClick={ flip }
                        >
                            <Icon name="arrow-up-down" size={ 15 } />
                        </button>
                    </div>
                    <AmountField
                        label={ t().swap.to }
                        amount={ quote === null ? '' : formatTokenAmount(quoteOut, (tokenOut as TokenRef | null)?.decimals ?? 18, 8) }
                        readOnly
                        token={ tokenOut }
                        onPickToken={ () => { pickerFor = 'out'; } }
                        balance={ balanceOut }
                        testId="amount-out"
                />
                </div>

                <Show when={ protocol === 'v3' && !isWrapPair && tierQuotes.length > 0 }>
                    <FeeTierSelect
                        tiers={ tierQuotes }
                        value={ feeTier }
                        bestFee={ bestTier(tierQuotes)?.fee ?? null }
                        onSelect={ (fee) => { feeTier = fee; } }
                    />
                </Show>

                <Show when={ quote !== null && tokenOut !== null && !isWrapPair }>
                    <dl class="mt-4 flex flex-col gap-1.5 rounded-xl border border-line bg-raised p-3.5 text-xs">
                        <div class="flex items-center justify-between">
                            <dt class="text-faint">{ t().swap.rate }</dt>
                            <dd class="font-mono text-val" data-ltr>
                            { `1 ${ tokenIn.symbol } = ${
                                parsedIn === null || quoteOut === 0n
                                    ? '-'
                                    : formatTokenAmount(
                                        quoteOut * 10n ** BigInt(tokenIn.decimals) / (parsedIn as bigint),
                                        (tokenOut as TokenRef).decimals,
                                        6
                                    )
                            } ${ (tokenOut as TokenRef | null)?.symbol ?? '' }` }
                            </dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="flex items-center gap-1.5 text-faint">
                                <span>{ t().swap.priceImpact }</span>
                                <Tooltip label={ t().swap.impactHint }>
                                    <Icon name="triangle-alert" size={ 12 } class="text-faint" />
                                </Tooltip>
                            </dt>
                            <dd
                                class="font-mono"
                                class:text-rise={ quoteImpact < 100 }
                                class:text-val={ quoteImpact >= 100 && quoteImpact < HIGH_IMPACT_BPS }
                                class:text-fall={ quoteImpact >= HIGH_IMPACT_BPS }
                                data-ltr
                            >
                            { fmtPercentBps(quoteImpact) }
                            </dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-faint">{ t().swap.minReceived }</dt>
                            <dd class="font-mono" data-ltr>
                            { formatTokenAmount(minOutForSlippage(quoteOut, slippageBps), (tokenOut as TokenRef | null)?.decimals ?? 18, 8) }
                            { ' ' }
                            { (tokenOut as TokenRef | null)?.symbol ?? '' }
                            </dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-faint">{ t().swap.fee }</dt>
                            <dd class="font-mono text-faint" data-ltr>{ fmtPercentBps(shownFeeBps) }</dd>
                        </div>
                    </dl>
                </Show>

                <Show when={ noRoute }>
                    <div class="mt-4 rounded-xl border border-line bg-raised p-4 text-center text-sm">
                        <p class="font-medium">{ protocol === 'v3' ? t().v3.noPool : t().swap.noRoute }</p>
                        <p class="mt-1 text-xs text-faint">{ t().swap.beFirstLp }</p>
                    </div>
                </Show>

                <Show when={ highImpact && !confirmedHighImpact }>
                    <div class="mt-4 rounded-xl border border-fall/50 bg-fall/8 p-4 text-xs leading-relaxed text-fall">
                    { t().swap.highImpact }
                    </div>
                </Show>

                <div class="mt-4">
                    <Show
                        when={ account() }
                        fallback={
                        <Button block size="lg" testId="connect" onClick={ () => { walletOpen = true; } }>
                            { t().common.connect }
                        </Button>
                    }
                    >
                        <Show
                            when={ onRightChain() }
                            fallback={
                            <Button block size="lg" variant="danger" onClick={ () => void switchChain() }>
                                { t().wallet.switchNetwork }
                            </Button>
                        }
                        >
                            <Show
                                when={ parsedIn !== null && tokenOut !== null }
                                fallback={
                                <Button block size="lg" disabled>
                                    { tokenOut === null ? t().swap.selectToken : t().swap.enterAmount }
                                </Button>
                            }
                            >
                                <Show
                                    when={ !insufficient }
                                    fallback={
                                    <Button block size="lg" disabled>
                                        { `${ t().swap.insufficient } (${ tokenIn.symbol })` }
                                    </Button>
                                }
                                >
                                    <Show
                                        when={ !needsApprove }
                                        fallback={
                                        <Button block size="lg" busy={ busy } testId="approve" onClick={ () => void approve() }>
                                            { `${ t().swap.approve } ${ tokenIn.symbol }` }
                                        </Button>
                                    }
                                    >
                                        <Show
                                            when={ highImpact && !confirmedHighImpact }
                                            fallback={
                                            <Button
                                                block
                                                size="lg"
                                                busy={ busy || quoting }
                                                disabled={ quote === null && !isWrapPair }
                                                testId="swap"
                                                onClick={ () => void swap() }
                                            >
                                                { isWrapPair
                                                    ? (isNative(tokenIn) ? t().swap.wrap : t().swap.unwrap)
                                                    : t().swap.swapAction }
                                            </Button>
                                        }
                                        >
                                            <Button block size="lg" variant="danger" testId="swap-anyway" onClick={ () => { confirmedHighImpact = true; } }>
                                            { t().swap.confirmHighImpact }
                                            </Button>
                                        </Show>
                                    </Show>
                                </Show>
                            </Show>
                        </Show>
                    </Show>
                </div>
            </div>
        </div>

        <Show when={ pickerFor !== null }>
            <TokenSelect
                tokens={ tokenList }
                exclude={ pickerFor === 'in' ? (tokenOut as TokenRef | null)?.address : tokenIn.address }
                onClose={ () => { pickerFor = null; } }
                onSelect={ (token) =>
                {
                    if (pickerFor === 'in')
                    {
                        tokenIn = token;
                    }
                    else
                    {
                        tokenOut = token;
                    }
                    pickerFor = null;
                } }
            />
        </Show>
        <Show when={ walletOpen }>
            <WalletModal onClose={ () => { walletOpen = false; } } />
        </Show>
    </section>
}
