import { minOutForSlippage } from '@nuraswap/shared/math';
import { counterpartAmount, getAmountsForLiquidity, getSqrtRatioAtTick, tickToPriceWad } from '@nuraswap/shared/v3-math';
import { formatTokenAmount, parseTokenAmount } from '@nuraswap/shared/digits';

import { ERC20_ABI, publicClient, v3Addresses } from '../../lib/chain.ts';
import type { Address } from '../../lib/chain.ts';
import { fmtAmount, fmtPercentBps } from '../../lib/format.ts';
import { t } from '../../lib/i18n.ts';
import { buildCollect, buildDecrease, buildIncrease } from '../../lib/v3.ts';
import type { PositionView, V3PoolState } from '../../lib/v3.ts';
import { account, balances, requiredWallet, sendTx, txEpoch } from '../../lib/wallet/store.ts';

import TokenIcon from './token-icon.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Modal from '../ui/modal.component.azeroth';

// One position, three things you can do to it: add to it, take some out, or
// collect what it has earned. Collect stands apart because fees are a separate
// on-chain balance from the principal - taking liquidity out sweeps them too,
// but collecting does not touch the position itself.
//
// Both sides move as ERC20s. A position holding WNURA takes WNURA and returns
// WNURA; wrapping is one step on the swap page, and hiding it inside this sheet
// would make the transaction depend on which token happened to be involved.

const MAX_UINT256 = (1n << 256n) - 1n;
const SLIPPAGE_BPS = 100;

export default component ManageV3Position(props: { view: PositionView; onClose: () => void })
{
    state mode: 'withdraw' | 'deposit' = 'withdraw';
    state percent = 50;
    state amount0Text = '';
    state amount1Text = '';
    state lastEdited: '0' | '1' = '0';
    state allowance0 = 0n;
    state allowance1 = 0n;
    state busy = false;

    const manager = (): Address => (v3Addresses()?.positionManager ?? '0x') as Address;
    const position = (): PositionView['position'] => props.view.position;
    const pool = (): V3PoolState | null => props.view.pool;

    const balanceOf = (token: string): bigint => balances()[token.toLowerCase()] ?? 0n;

    derived sqrtLower = getSqrtRatioAtTick(position().tickLower);
    derived sqrtUpper = getSqrtRatioAtTick(position().tickUpper);
    derived sqrtPrice = pool()?.sqrtPriceX96 ?? 0n;

    // ---- withdraw -------------------------------------------------------
    derived burnLiquidity = (position().liquidity * BigInt(percent)) / 100n;

    derived burnAmounts = sqrtPrice <= 0n || burnLiquidity <= 0n
        ? { amount0: 0n, amount1: 0n }
        : getAmountsForLiquidity(sqrtPrice, sqrtLower, sqrtUpper, burnLiquidity);

    // ---- deposit --------------------------------------------------------
    // Outside its range a position takes one token only - the same rule the mint
    // flow follows, for the same reason: the pool will not accept the other.
    derived needs0 = sqrtPrice <= 0n || sqrtPrice < sqrtUpper;
    derived needs1 = sqrtPrice <= 0n || sqrtPrice > sqrtLower;

    derived parsed0 = parseTokenAmount(amount0Text, props.view.ref0.decimals);
    derived parsed1 = parseTokenAmount(amount1Text, props.view.ref1.decimals);

    effect (amount0Text, amount1Text, mode)
    {
        if (mode !== 'deposit' || sqrtPrice <= 0n || !needs0 || !needs1)
        {
            return;
        }
        const known = lastEdited === '0' ? parsed0 : parsed1;
        if (known === null || (known as bigint) <= 0n)
        {
            return;
        }
        const other = counterpartAmount(sqrtPrice, sqrtLower, sqrtUpper, {
            side: lastEdited === '0' ? 0 : 1,
            amount: known as bigint
        });
        if (lastEdited === '0')
        {
            amount1Text = formatTokenAmount(other, props.view.ref1.decimals, 8);
        }
        else
        {
            amount0Text = formatTokenAmount(other, props.view.ref0.decimals, 8);
        }
    }

    effect (account(), txEpoch())
    {
        allowance0 = MAX_UINT256;
        allowance1 = MAX_UINT256;
        const owner = account();
        if (owner === null)
        {
            return;
        }
        for (const [token, assign] of [
            [props.view.ref0.address, (value: bigint) => { allowance0 = value; }],
            [props.view.ref1.address, (value: bigint) => { allowance1 = value; }]
        ] as Array<[string, (value: bigint) => void]>)
        {
            void publicClient().readContract({
                address: token as Address,
                abi: ERC20_ABI,
                functionName: 'allowance',
                args: [owner, manager()]
            }).then((value) => assign(value as bigint)).catch(() => undefined);
        }
    }

    derived needsApprove0 = needs0 && parsed0 !== null && allowance0 < (parsed0 as bigint);
    derived needsApprove1 = needs1 && parsed1 !== null && allowance1 < (parsed1 as bigint);

    derived depositReady = ((needs0 && parsed0 !== null && (parsed0 as bigint) > 0n)
        || (needs1 && parsed1 !== null && (parsed1 as bigint) > 0n))
        && !(parsed0 !== null && (parsed0 as bigint) > balanceOf(props.view.ref0.address))
        && !(parsed1 !== null && (parsed1 as bigint) > balanceOf(props.view.ref1.address));

    derived hasFees = props.view.fees0 > 0n || props.view.fees1 > 0n;

    const deadline = async (): Promise<bigint> =>
    {
        const reader = publicClient();
        const block = await reader.getBlock({ blockTag: 'pending' }).catch(() => reader.getBlock());
        return block.timestamp + 1200n;
    };

    const label = (): string =>
        `${ props.view.ref0.symbol }/${ props.view.ref1.symbol } #${ position().tokenId }`;

    const approveToken = async (token: string, symbol: string, amount: bigint): Promise<void> =>
    {
        busy = true;
        await sendTx(
            `${ t().swap.approve } ${ symbol }`,
            () => requiredWallet().writeContract({
                address: token as Address,
                abi: ERC20_ABI,
                functionName: 'approve',
                args: [manager(), amount]
            } as never)
        );
        busy = false;
    };

    const withdraw = async (): Promise<void> =>
    {
        const owner = account() as Address;
        if (owner === null || burnLiquidity <= 0n)
        {
            return;
        }
        busy = true;
        const when = await deadline();
        const ok = await sendTx(
            `${ t().v3.decrease }: ${ label() }`,
            () => requiredWallet().writeContract(buildDecrease({
                manager: manager(),
                tokenId: position().tokenId,
                liquidity: burnLiquidity,
                amount0Min: minOutForSlippage(burnAmounts.amount0, SLIPPAGE_BPS),
                amount1Min: minOutForSlippage(burnAmounts.amount1, SLIPPAGE_BPS),
                recipient: owner,
                deadline: when
            }) as never)
        );
        busy = false;
        if (ok)
        {
            props.onClose();
        }
    };

    const deposit = async (): Promise<void> =>
    {
        busy = true;
        const when = await deadline();
        const amount0 = parsed0 ?? 0n;
        const amount1 = parsed1 ?? 0n;
        const ok = await sendTx(
            `${ t().v3.increase }: ${ label() }`,
            () => requiredWallet().writeContract(buildIncrease({
                manager: manager(),
                tokenId: position().tokenId,
                amount0Desired: amount0,
                amount1Desired: amount1,
                amount0Min: minOutForSlippage(amount0, SLIPPAGE_BPS),
                amount1Min: minOutForSlippage(amount1, SLIPPAGE_BPS),
                deadline: when,
                nativeValue: 0n
            }) as never)
        );
        busy = false;
        if (ok)
        {
            props.onClose();
        }
    };

    const collect = async (): Promise<void> =>
    {
        const owner = account() as Address;
        if (owner === null)
        {
            return;
        }
        busy = true;
        const ok = await sendTx(
            `${ t().v3.collect }: ${ label() }`,
            () => requiredWallet().writeContract(buildCollect(manager(), position().tokenId, owner) as never)
        );
        busy = false;
        if (ok)
        {
            props.onClose();
        }
    };

    const priceLabel = (tick: number): string =>
        fmtAmount(tickToPriceWad(tick, props.view.ref0.decimals, props.view.ref1.decimals), 18);

    <Modal title={ t().v3.manage } onClose={ props.onClose }>
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-2">
                    <span class="flex -space-x-2" data-ltr>
                        <TokenIcon symbol={ props.view.ref0.symbol } address={ props.view.ref0.address } size={ 24 } />
                        <TokenIcon symbol={ props.view.ref1.symbol } address={ props.view.ref1.address } size={ 24 } />
                    </span>
                    <span class="text-sm font-medium" data-ltr>
                        { `${ props.view.ref0.symbol }/${ props.view.ref1.symbol } · ${ fmtPercentBps(position().fee / 100) }` }
                    </span>
                </span>
                <Show
                    when={ position().liquidity > 0n }
                    fallback={ <Badge>{ t().v3.closed }</Badge> }
                >
                    <Badge tone={ props.view.active ? 'rise' : 'fall' }>
                        { props.view.active ? t().v3.inRange : t().v3.outOfRange }
                    </Badge>
                </Show>
            </div>

            <dl class="rounded-xl border border-line bg-raised p-3.5 text-xs">
                <div class="flex justify-between gap-3 py-0.5">
                    <dt class="text-faint">{ t().v3.range }</dt>
                    <dd class="font-mono text-end" data-ltr>
                        { `${ priceLabel(position().tickLower) } - ${ priceLabel(position().tickUpper) }` }
                    </dd>
                </div>
                <div class="flex justify-between py-0.5">
                    <dt class="text-faint">{ t().v3.unclaimedFees }</dt>
                    <dd class="font-mono text-rise text-end" data-ltr>
                        { `${ fmtAmount(props.view.fees0, props.view.ref0.decimals) } ${ props.view.ref0.symbol } · ${ fmtAmount(props.view.fees1, props.view.ref1.decimals) } ${ props.view.ref1.symbol }` }
                    </dd>
                </div>
            </dl>

            <Show when={ hasFees }>
                <Button variant="ghost" block busy={ busy } testId="v3-collect" onClick={ () => void collect() }>
                    { t().v3.collect }
                </Button>
            </Show>

            <div class="flex gap-2">
                <button
                    type="button"
                    class={ mode === 'withdraw' ? 'btn-ice h-9 flex-1 text-xs' : 'btn-ghost h-9 flex-1 text-xs' }
                    aria-pressed={ String(mode === 'withdraw') }
                    data-testid="v3-mode-withdraw"
                    onClick={ () => { mode = 'withdraw'; } }
                >
                    { t().v3.decrease }
                </button>
                <button
                    type="button"
                    class={ mode === 'deposit' ? 'btn-ice h-9 flex-1 text-xs' : 'btn-ghost h-9 flex-1 text-xs' }
                    aria-pressed={ String(mode === 'deposit') }
                    data-testid="v3-mode-deposit"
                    onClick={ () => { mode = 'deposit'; } }
                >
                    { t().v3.increase }
                </button>
            </div>

            <Show
                when={ mode === 'withdraw' }
                fallback={
                    <div class="flex flex-col gap-2.5">
                        <Show when={ needs0 }>
                            <label class="flex flex-col gap-1 rounded-xl border border-line bg-raised p-3">
                                <span class="flex items-center justify-between text-xs text-faint">
                                    <span data-ltr>{ props.view.ref0.symbol }</span>
                                    <span class="font-mono">{ fmtAmount(balanceOf(props.view.ref0.address), props.view.ref0.decimals) }</span>
                                </span>
                                <input
                                    class="w-full min-w-0 bg-transparent font-mono text-lg text-ink outline-none placeholder:text-faint"
                                    value={ amount0Text }
                                    placeholder="0"
                                    inputmode="decimal"
                                    aria-label={ props.view.ref0.symbol }
                                    data-testid="v3-inc-0"
                                    data-ltr
                                    onInput={ (event) =>
                                    {
                                        lastEdited = '0';
                                        amount0Text = (event.currentTarget as HTMLInputElement).value;
                                    } }
                                />
                            </label>
                        </Show>
                        <Show when={ needs1 }>
                            <label class="flex flex-col gap-1 rounded-xl border border-line bg-raised p-3">
                                <span class="flex items-center justify-between text-xs text-faint">
                                    <span data-ltr>{ props.view.ref1.symbol }</span>
                                    <span class="font-mono">{ fmtAmount(balanceOf(props.view.ref1.address), props.view.ref1.decimals) }</span>
                                </span>
                                <input
                                    class="w-full min-w-0 bg-transparent font-mono text-lg text-ink outline-none placeholder:text-faint"
                                    value={ amount1Text }
                                    placeholder="0"
                                    inputmode="decimal"
                                    aria-label={ props.view.ref1.symbol }
                                    data-testid="v3-inc-1"
                                    data-ltr
                                    onInput={ (event) =>
                                    {
                                        lastEdited = '1';
                                        amount1Text = (event.currentTarget as HTMLInputElement).value;
                                    } }
                                />
                            </label>
                        </Show>
                        <p class="text-xs leading-relaxed text-faint">{ t().v3.wrappedOnly }</p>
                        <Show
                            when={ needsApprove0 }
                            fallback={
                                <Show
                                    when={ needsApprove1 }
                                    fallback={
                                        <Button
                                            block
                                            size="lg"
                                            busy={ busy }
                                            disabled={ !depositReady }
                                            testId="v3-increase"
                                            onClick={ () => void deposit() }
                                        >
                                            { t().v3.increase }
                                        </Button>
                                    }
                                >
                                    <Button block size="lg" busy={ busy } onClick={ () => void approveToken(props.view.ref1.address, props.view.ref1.symbol, parsed1 as bigint) }>
                                        { `${ t().swap.approve } ${ props.view.ref1.symbol }` }
                                    </Button>
                                </Show>
                            }
                        >
                            <Button block size="lg" busy={ busy } onClick={ () => void approveToken(props.view.ref0.address, props.view.ref0.symbol, parsed0 as bigint) }>
                                { `${ t().swap.approve } ${ props.view.ref0.symbol }` }
                            </Button>
                        </Show>
                    </div>
                }
            >
                <div class="flex flex-col gap-3">
                    <div class="rounded-xl border border-line bg-raised p-4">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-faint">{ t().liquidity.removeAmount }</span>
                            <span class="font-mono text-lg text-ink" data-ltr>{ `${ percent }%` }</span>
                        </div>
                        <input
                            type="range"
                            class="mt-3 w-full accent-(--ice)"
                            min="1"
                            max="100"
                            value={ String(percent) }
                            aria-label={ t().liquidity.removeAmount }
                            data-testid="v3-percent"
                            onInput={ (event) => { percent = Number((event.currentTarget as HTMLInputElement).value); } }
                        />
                        <div class="mt-2 flex gap-2">
                            <For each={ [25, 50, 75, 100] } key={ (step) => String(step) } let={ step }>
                                <button
                                    type="button"
                                    class={ percent === step ? 'btn-ice h-8 flex-1 text-xs' : 'btn-ghost h-8 flex-1 text-xs' }
                                    onClick={ () => { percent = step; } }
                                >
                                    <span data-ltr>{ `${ step }%` }</span>
                                </button>
                            </For>
                        </div>
                    </div>
                    <dl class="rounded-xl border border-line bg-raised p-3.5 text-xs">
                        <div class="flex justify-between py-0.5">
                            <dt class="text-faint">{ t().liquidity.receiveEstimate }</dt>
                            <dd class="font-mono text-end" data-ltr>
                                { `${ fmtAmount(burnAmounts.amount0, props.view.ref0.decimals) } ${ props.view.ref0.symbol }` }
                            </dd>
                        </div>
                        <div class="flex justify-between py-0.5">
                            <dt></dt>
                            <dd class="font-mono text-end" data-ltr>
                                { `${ fmtAmount(burnAmounts.amount1, props.view.ref1.decimals) } ${ props.view.ref1.symbol }` }
                            </dd>
                        </div>
                    </dl>
                    <p class="text-xs leading-relaxed text-faint">{ t().v3.decreaseCollects }</p>
                    <Button
                        block
                        size="lg"
                        busy={ busy }
                        disabled={ position().liquidity === 0n }
                        testId="v3-decrease"
                        onClick={ () => void withdraw() }
                    >
                        { t().liquidity.confirmRemove }
                    </Button>
                </div>
            </Show>
        </div>
    </Modal>
}
