import type { Protocol } from '../../lib/v3.ts';
import { t } from '../../lib/i18n.ts';

import Tooltip from '../ui/tooltip.component.azeroth';

// The one place a trader chooses which exchange they are looking at. V2 and V3
// are not two views of the same pool - they are different contracts holding
// different liquidity at different prices - so this is a switch, never a
// preference that silently reroutes a trade.
//
// Rendered only where the deployment actually carries a V3 factory; the callers
// guard on v3Addresses() so a V2-only chain never shows a dead half.

const ACTIVE = 'rounded-md px-2.5 py-1 text-xs font-semibold bg-ice/15 text-ice';
const IDLE = 'rounded-md px-2.5 py-1 text-xs font-medium text-faint hover:text-ink';

export default component ProtocolSwitch(props: { value: Protocol; onChange: (next: Protocol) => void })
{
    <div
        class="inline-flex items-center gap-0.5 rounded-lg border border-line bg-raised p-0.5"
        role="group"
        aria-label={ t().v3.protocol }
        data-ltr
    >
        <Tooltip label={ t().v3.v2Hint }>
            <button
                type="button"
                class={ props.value === 'v2' ? ACTIVE : IDLE }
                aria-pressed={ String(props.value === 'v2') }
                data-testid="protocol-v2"
                onClick={ () => props.onChange('v2') }
            >
                V2
            </button>
        </Tooltip>
        <Tooltip label={ t().v3.v3Hint }>
            <button
                type="button"
                class={ props.value === 'v3' ? ACTIVE : IDLE }
                aria-pressed={ String(props.value === 'v3') }
                data-testid="protocol-v3"
                onClick={ () => props.onChange('v3') }
            >
                V3
            </button>
        </Tooltip>
    </div>
}
