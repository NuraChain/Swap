import { flagSrc } from '../../lib/i18n.ts';
import type { Lang } from '../../lib/i18n.ts';

// The flag as a flag: a 4:3 rectangle with softened corners, the same shape the
// Nura landing page uses, so the language picker reads the same across the two
// sites. `size` is the HEIGHT - the width follows the ratio, because a flag
// squeezed into a square is a different flag.

export default component Flag(props: { lang: Lang; size?: number })
{
    const height = (): number => props.size ?? 18;
    const width = (): number => Math.round(height() * 4 / 3);

    <img
        src={ flagSrc(props.lang) }
        alt=""
        width={ width() }
        height={ height() }
        loading="lazy"
        class="shrink-0 rounded-[4px] object-cover"
        style={ `width:${ width() }px;height:${ height() }px` }
        aria-hidden="true"
    />
}
