import { RouterProvider, Routes, createRouter, createMemoryHistory } from 'azerothjs';
import type { LoaderHandoff } from 'azerothjs';

import { routes } from './routes.ts';
import { ensureDeployment } from './lib/chain.ts';
import { currentLang, setLang, t } from './lib/i18n.ts';
import { landingTitle, setDocumentTitle } from './lib/seo.ts';
import { currentTheme } from './lib/theme.ts';
import { whitepaperLangOf } from './lib/whitepaper/index.ts';
import { startNuraConnector } from './lib/wallet/nura.ts';

import Footer from './components/layout/footer.component.azeroth';
import Header from './components/layout/header.component.azeroth';
import IndexerBanner from './components/layout/indexer-banner.component.azeroth';
import Toasts from './components/ui/toasts.component.azeroth';

export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined,
        initialLoaderData: props.handoff
    });

    // A URL can DECLARE a language - the paper's ten addresses do - and when it
    // does it outranks the stored preference: an address is the more deliberate
    // choice, and a prerendered /whitepaper/fa has to come out Persian with no
    // browser to ask. Read during CONSTRUCTION, so the first markup is already
    // in that language rather than flipping to it a frame later.
    const declared = whitepaperLangOf(router.location().pathname);
    if (declared !== null)
    {
        setLang(declared);
    }
    else if (typeof window === 'undefined')
    {
        // Server-side there is nothing to remember a preference, and ONE module
        // instance renders every prerendered page in turn - so a page that
        // declares no language says so, rather than inheriting the language of
        // whichever page was rendered before it.
        setLang('en');
    }

    // And it keeps outranking it: following a link from one translation to
    // another is a language change like any other.
    effect (router.location().pathname)
    {
        const lang = whitepaperLangOf(router.location().pathname);
        if (lang !== null && lang !== currentLang())
        {
            setLang(lang);
        }
    }

    // Each prerendered page ships its own title (scripts/build-seo.mjs); a
    // client-side navigation has to keep it honest, or the tab still names the
    // page the reader left. The paper's ten pages are the exception - only the
    // page itself holds the document that names it - so they set their own.
    effect (router.location().pathname, currentLang())
    {
        if (whitepaperLangOf(router.location().pathname) === null)
        {
            setDocumentTitle(router.location().pathname === '/' ? landingTitle(t()) : t().nav.home);
        }
    }

    mount
    {
        // First browser read applies the persisted language and theme; the
        // deployment fetch warms every page's chain access.
        currentLang();
        currentTheme();
        // Warm-up only: a failure here is not this component's to report. The
        // pages that need the deployment await it themselves and show their own
        // empty state, and Connect says it in words - swallowing the rejection
        // keeps a down api half out of the console as an unhandled one.
        //
        // The Nura Wallet connector hangs off the SAME fetch rather than its own:
        // it announces the chain id it will answer `eth_chainId` with, and that
        // id belongs to the deployment. No artifact means no connector - and
        // nothing to connect to either.
        void ensureDeployment()
            .then((info) => { startNuraConnector(info.chainId); })
            .catch(() => undefined);
    }

    <RouterProvider router={ router }>
        <div class="flex min-h-screen flex-col">
            <IndexerBanner />
            <Header />
            <main class="motion-safe:animate-rise flex-1">
                <Routes fallback={ () =>
                    <section class="mx-auto max-w-6xl px-4 py-24 text-center">
                        <h1 class="font-display text-2xl">{ t().common.notFound }</h1>
                    </section>
                } />
            </main>
            <Footer />
            <Toasts />
        </div>
    </RouterProvider>
}
