import { RouterProvider, Routes, createRouter, createMemoryHistory, useHead } from 'azerothjs';
import type { LoaderHandoff } from 'azerothjs';

import { routes } from './routes.ts';
import { ensureDeployment } from './lib/chain.ts';
import { t } from './lib/i18n.ts';
import { OG_HEIGHT, OG_IMAGE_PATH, OG_WIDTH, ROBOTS_DIRECTIVE, siteOrigin } from './lib/seo.ts';
import { currentTheme } from './lib/theme.ts';
import { startNuraConnector } from './lib/wallet/nura.ts';

import Footer from './components/layout/footer.component.azeroth';
import Header from './components/layout/header.component.azeroth';
import IndexerBanner from './components/layout/indexer-banner.component.azeroth';
import Toasts from './components/ui/toasts.component.azeroth';

export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined,
        initialLoaderData: props.handoff
    });

    // The site-wide head defaults: the card every page shares, the robots
    // directive of THIS build, and the origin the pages claim. A page's own
    // useHead wins per key (title, description, og:url, og:locale, the
    // hreflang cluster) and falls back to these when it declares none - the
    // nesting IS the precedence, so no page repeats the card. The one inline
    // fact here is deliberately not here: the language and direction are the
    // host's to stamp on <html> before any script runs, and the framework's
    // locale negotiation owns them.
    useHead({
        title: () => t().nav.home,
        meta: [
            { name: 'robots', content: ROBOTS_DIRECTIVE },
            { property: 'og:site_name', content: 'Nura Swap' },
            { property: 'og:type', content: 'website' },
            { property: 'og:image', content: `${ siteOrigin() }${ OG_IMAGE_PATH }` },
            // Stated rather than left to be discovered: a crawler that has not
            // yet fetched the image still lays the card out correctly, and the
            // first unfurl is the one that gets cached.
            { property: 'og:image:width', content: String(OG_WIDTH) },
            { property: 'og:image:height', content: String(OG_HEIGHT) },
            { property: 'og:image:type', content: 'image/png' },
            { name: 'twitter:card', content: 'summary_large_image' },
            { name: 'twitter:image', content: `${ siteOrigin() }${ OG_IMAGE_PATH }` }
        ]
    });

    mount
    {
        // First browser read applies the persisted theme; the deployment fetch
        // warms every page's chain access.
        currentTheme();
        // Warm-up only: a failure here is not this component's to report. The
        // pages that need the deployment await it themselves and show their own
        // empty state, and Connect says it in words - swallowing the rejection
        // keeps a down api half out of the console as an unhandled one.
        //
        // The Nura Wallet connector hangs off the SAME fetch rather than its own:
        // it announces the chain id it will answer `eth_chainId` with, and that
        // id belongs to the deployment. No artifact means no connector - and
        // nothing to connect to either.
        void ensureDeployment()
            .then((info) => { startNuraConnector(info.chainId); })
            .catch(() => undefined);
    }

    <RouterProvider router={ router }>
        <div class="flex min-h-screen flex-col">
            <IndexerBanner />
            <Header />
            <main class="motion-safe:animate-rise flex-1">
                <Routes fallback={ () =>
                    <section class="mx-auto max-w-6xl px-4 py-24 text-center">
                        <h1 class="font-display text-2xl">{ t().common.notFound }</h1>
                    </section>
                } />
            </main>
            <Footer />
            <Toasts />
        </div>
    </RouterProvider>
}
