# Copy to .env at the repository root (never commit .env). Read by the loadConfig
# block in server/src/main.ts. Every variable is REQUIRED - there are no defaults,
# and a missing one stops the boot with the list of what is missing.

# The port the one-origin server listens on.
PORT=
# development | production | test
NODE_ENV=
# The chain this server indexes and serves - the matching deployment artifact must
# exist at shared/deployments/<CHAIN_ID>.json.
CHAIN_ID=
# The indexer's PostgreSQL database, one per chain:
# postgres://user:password@host:5432/nuraswap
DATABASE_URL=
# Where the built client lives in production, relative to the repository root
# (the server serves it - one origin). Built by `npm run build`: application/dist
CLIENT_DIR=
# The SSR bundle built by `vite build --ssr`, relative to the repository root:
# application/dist-server/entry.server.js
SSR_ENTRY=
# true ONLY when a reverse proxy (Caddy, nginx) terminates TLS in front of this
# server. It decides whether the rate limiter believes X-Forwarded-For: off behind
# a proxy, every visitor shares one 2000/min bucket and one client can lock the
# exchange out for everyone; on without a proxy, any client can forge the header
# and mint itself unlimited buckets.
TRUST_PROXY=
# The only outbound HTTP this server makes: live USD prices for BRIDGED assets,
# which no pool on this chain can value. false, their USD figures read $0 - correct
# for an air-gapped box, wrong everywhere else. Sources are tried in order
# (Binance, then CoinGecko) and the last good price is kept when both are down.
PRICE_FEED=
# How often the price feed refreshes, in milliseconds.
PRICE_FEED_MS=
# The devtools bridge's shared secret (development only, 16+ characters):
# `node -e "console.log(crypto.randomUUID())"`. Empty, the bridge does not attach.
DEVTOOLS_TOKEN=
