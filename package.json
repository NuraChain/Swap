{
    "name": "nuraswap",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "application",
        "server",
        "shared"
    ],
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check",
        "build": "azeroth build",
        "start": "npm start --workspace server",
        "test": "azeroth test && npm test --workspace shared",
        "test:shared": "npm test --workspace shared",
        "test:server": "npm test --workspace server",
        "test:web": "npm test --workspace application",
        "test:app": "azeroth test",
        "coverage": "npm run coverage --workspace shared && npm run coverage --workspace server && npm run coverage --workspace application",
        "lint:rtl": "node application/scripts/lint-rtl.mjs",
        "verify": "npm run lint:rtl && npm run check && npm run build && npm test"
    },
    "devDependencies": {
        "@azerothjs/cli": "^2.0.0-beta.2",
        "@vitest/coverage-v8": "^4.1.11"
    }
}
