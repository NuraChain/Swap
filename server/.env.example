# Copy to .env for local overrides (never commit .env). Read by the loadConfig block in src/main.ts.
PORT=4000
NODE_ENV=production
# The chain this server indexes and serves - the matching deployment artifact must
# exist at shared/deployments/<CHAIN_ID>.json.
CHAIN_ID=1020
# Where the sqlite database files live (one file per chain). On a VPS, point this at
# a persistent disk.
DATA_DIR=../data
# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js
# Set this to true ONLY when a reverse proxy (Caddy, nginx) terminates TLS in
# front of this server. It decides whether the rate limiter believes
# X-Forwarded-For: off behind a proxy, every visitor shares one 2000/min bucket
# and one client can lock the exchange out for everyone; on without a proxy, any
# client can forge the header and mint itself unlimited buckets.
TRUST_PROXY=true
# The devtools bridge's shared secret (dev only). `create-azeroth` generates one into
# .env; set your own with `node -e "console.log(crypto.randomUUID())"`. Leave it unset and
# the bridge simply does not attach.
DEVTOOLS_TOKEN=

# The only outbound HTTP this server makes: live USD prices for BRIDGED assets,
# which no pool on this chain can value. Off, their USD figures read $0 - correct
# for an air-gapped box, wrong everywhere else. Sources are tried in order
# (Binance, then CoinGecko) and the last good price is kept when both are down.
PRICE_FEED=true
PRICE_FEED_MS=60000
