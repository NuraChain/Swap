# TLS terminator in front of the single-origin server. Caddy provisions and renews
# the certificate itself; swap nuraswap.example for the real host.
nuraswap.example {
    encode zstd gzip

    # Hashed asset filenames are immutable; the HTML that references them is not.
    @assets path /assets/* /icons.svg /coins.svg
    header @assets Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy 127.0.0.1:3000
}
