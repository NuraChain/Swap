# Copy to .env (never commit .env). Read by hardhat.config.ts and scripts/chains.ts.

# BSC testnet RPC. The default public endpoint works; a dedicated one is steadier.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# The deployer account for testnet/mainnet deploys. Fund it from the BSC testnet
# faucet before `npm run deploy:testnet`. NEVER a key that holds real funds.
DEPLOYER_PRIVATE_KEY=
